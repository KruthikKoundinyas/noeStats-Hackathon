                  "pm.test('Adds viewer',()=>pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/members"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lists creator plus three assigned members',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().items.length).to.eql(4);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Change Viewer Role",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"role\":\"TEAM_MEMBER\"}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/members/{{viewerId}}"
          },
