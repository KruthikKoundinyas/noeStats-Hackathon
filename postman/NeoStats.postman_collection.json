                  "pm.test('Restores project role',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Tasks Comments Activity Notifications",
      "item": [
        {
          "name": "Create Assigned Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Postman task\",\"description\":\"Exercise all task APIs\",\"assigneeId\":\"{{memberId}}\"}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const t=pm.response.json().task;pm.test('Creates task at version 1',()=>{pm.response.to.have.status(201);pm.expect(t.version).to.eql(1);});pm.collectionVariables.set('taskId',t._id);pm.collectionVariables.set('taskVersion',t.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Tasks with filters",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks?status=TODO&assigneeId={{memberId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lists tasks',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().items).to.be.an('array');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read Task",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reads task',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Postman task updated\",\"status\":\"IN_PROGRESS\",\"version\":{{taskVersion}}}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const t=pm.response.json().task;pm.test('Updates and increments version',()=>{pm.response.to.have.status(200);pm.expect(t.version).to.eql(2);});pm.collectionVariables.set('taskVersion',t.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Stale Task Update",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"DONE\",\"version\":1}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 409 and latest task',()=>{pm.response.to.have.status(409);pm.expect(pm.response.json().details.latest.version).to.eql(2);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"content\":\"Comment from Postman\"}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Creates comment',()=>pm.response.to.have.status(201));pm.collectionVariables.set('commentId',pm.response.json().comment._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Comments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/comments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lists comments',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().items.length).to.be.above(0);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Project Activity",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/activity"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Shows activity',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().items.length).to.be.above(0);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Member",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"member@neostats.local\",\"password\":\"{{password}}\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Member login and HTTP-only cookie created',()=>{pm.response.to.have.status(200);pm.expect(pm.cookies.has('neostats_token')).to.eql(true);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Member Updates Assigned Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"DONE\",\"title\":\"Ignored unauthorized field\",\"version\":{{taskVersion}}}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const t=pm.response.json().task;pm.test('Member changes status only',()=>{pm.response.to.have.status(200);pm.expect(t.status).to.eql('DONE');pm.expect(t.title).to.eql('Postman task updated');});pm.collectionVariables.set('taskVersion',t.version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Member Notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/notifications?unread=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b=pm.response.json();pm.test('Gets unread notifications',()=>{pm.response.to.have.status(200);pm.expect(b.items.length).to.be.above(0);});pm.collectionVariables.set('notificationId',b.items[0]._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Marks read',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().notification.readAt).to.not.eql(null);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Viewer",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"viewer@neostats.local\",\"password\":\"{{password}}\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Viewer login and HTTP-only cookie created',()=>{pm.response.to.have.status(200);pm.expect(pm.cookies.has('neostats_token')).to.eql(true);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Viewer Cannot Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"title\":\"Forbidden\"}" },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Server enforces Viewer read-only',()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Cleanup and Session",
      "item": [
        {
          "name": "Login Admin Again",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@neostats.local\",\"password\":\"{{password}}\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login and HTTP-only cookie created',()=>{pm.response.to.have.status(200);pm.expect(pm.cookies.has('neostats_token')).to.eql(true);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/comments/{{commentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Deletes comment',()=>pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
