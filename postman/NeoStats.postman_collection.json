              }
            }
          ]
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"description\":\"Updated via Postman\",\"markdownContent\":\"# Updated\"}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Updates project',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Manager",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"userId\":\"{{managerId}}\",\"role\":\"PROJECT_MANAGER\"}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/members"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Adds manager',()=>pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"userId\":\"{{memberId}}\",\"role\":\"TEAM_MEMBER\"}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/members"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Adds member',()=>pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Viewer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"userId\":\"{{viewerId}}\",\"role\":\"VIEWER\"}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/members"
          },
          "event": [
            {
              "listen": "test",
              "script": {
