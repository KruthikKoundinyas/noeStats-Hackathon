{
  "info": {
    "name": "NeoStats Backend - Complete API Tests",
    "description": "Run in order after npm run seed. Tests all minimal backend resources, authorization, logout, and optimistic concurrency.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "password", "value": "Password123!" },
    { "key": "projectId", "value": "" },
    { "key": "managerId", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "viewerId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "taskVersion", "value": "" },
    { "key": "commentId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "auth": { "type": "noauth" },
  "item": [
    {
      "name": "01 Authentication and Users",
      "item": [
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 and healthy', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register ordinary user (Admin request is ignored)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Registration Test\",\n  \"email\": \"registration{{$timestamp}}@example.com\",\n  \"password\": \"Password123!\",\n  \"requestedRole\": \"VIEWER\",\n  \"platformRole\": \"ADMIN\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b=pm.response.json(); pm.test('201 USER, never self-appointed Admin',()=>{pm.response.to.have.status(201);pm.expect(b.user.platformRole).to.eql('USER');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@neostats.local\",\"password\":\"{{password}}\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b=pm.response.json();pm.test('Admin login and HTTP-only cookie created',()=>{pm.response.to.have.status(200);pm.expect(b.user.platformRole).to.eql('ADMIN');pm.expect(pm.cookies.has('neostats_token')).to.eql(true);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Current User",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns Admin',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().user.email).to.eql('admin@neostats.local');});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Users and save seeded IDs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users?limit=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b=pm.response.json();pm.test('Lists users',()=>{pm.response.to.have.status(200);pm.expect(b.items).to.be.an('array');});for(const u of b.items){if(u.email==='manager@neostats.local')pm.collectionVariables.set('managerId',u._id);if(u.email==='member@neostats.local')pm.collectionVariables.set('memberId',u._id);if(u.email==='viewer@neostats.local')pm.collectionVariables.set('viewerId',u._id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"API User\",\"email\":\"api{{$timestamp}}@example.com\",\"password\":\"Password123!\",\"requestedRole\":\"TEAM_MEMBER\"}"
            },
            "url": "{{baseUrl}}/api/users"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin creates user',()=>pm.response.to.have.status(201));pm.collectionVariables.set('createdUserId',pm.response.json().user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{createdUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reads user',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Updated API User\"}" },
            "url": "{{baseUrl}}/api/users/{{createdUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Updates user',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().user.name).to.eql('Updated API User');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Change Platform Role",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"platformRole\":\"ADMIN\"}" },
            "url": "{{baseUrl}}/api/users/{{createdUserId}}/role"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Changes trusted role',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().user.platformRole).to.eql('ADMIN');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/users/{{createdUserId}}/deactivate"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Deactivates user',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().user.isActive).to.eql(false);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Bad Registration Validation",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"bad\",\"password\":\"short\"}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Rejects missing fields',()=>pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Projects and Members",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Postman Project {{$timestamp}}\",\"description\":\"Created by collection\",\"markdownContent\":\"# Postman Project\"}"
            },
            "url": "{{baseUrl}}/api/projects"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b=pm.response.json();pm.test('Creates project',()=>pm.response.to.have.status(201));pm.collectionVariables.set('projectId',b.project._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Projects",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects?status=ACTIVE"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
