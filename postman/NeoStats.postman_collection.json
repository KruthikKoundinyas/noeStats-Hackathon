            "body": {
              "mode": "raw",
              "raw": "{\"role\":\"VIEWER\"}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/members/{{viewerId}}"
          },
          "event": [
            {
              "listen": "test",
